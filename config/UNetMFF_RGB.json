{
    "name": "Landsat8_UNetMFF_RGB",
    "n_gpu": 1,
    "hyperparameter_tuning": {
        "enabled": true
    },
    "arch": {
        "type": "UNetMFF",
        "args": {
            "input_channels": 3,
            "num_classes": 2,
            "topology": "ENC_4_DEC_4"
        }
    },
    "train_data_loader": {
        "type": "Landsat8TrainDataLoader",
        "args": {
            "data_dir": "Data/train/training_2015_pickled_data",
            "data_split_lists_path": "Data/train/temp_split",
            "batch_size": 32,
            "model_input_size": 128,
            "bands": [
                4,
                3,
                2
            ],
            "num_classes": 2,
            "one_hot": true
        }
    },
    "inference_data_loader": {
        "type": "Landsat8InferenceDataLoader",
        "data_path": "/content/drive/MyDrive/Forest_DAAD_Data/inference/images",
        "destination": "saved/inference",
        "args": {
            "rasterized_shapefiles_path": "/content/drive/MyDrive/Forest_DAAD_Data/inference/shapefiles",
            "bands": [
                4,
                3,
                2
            ],
            "model_input_size": 128,
            "num_classes": 2,
            "batch_size": 32
        }
    },
    "optimizer": {
        "type": "AdamW",
        "args": {
            "lr": 0.0003,
            "weight_decay": 0.0001
        }
    },
    "loss": "focal_loss2d",
    "metrics": [
        "accuracy",
        "f1_score",
        "precision",
        "recall",
        "compute_iou"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 60,
            "eta_min": 1e-6
        }
    },
    "trainer": {
        "epochs": 50,
        "save_dir": "saved/",
        "pretrained_model": null,
        "save_period": 1,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 0,
        "tensorboard": false,
        "mode": "train"
    }
}